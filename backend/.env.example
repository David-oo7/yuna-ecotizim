# --- Umumiy ---
APP_ENV=dev
APP_SECRET_KEY=change-me-64-random-chars
APP_BASE_URL=http://localhost:8000

# --- Baza ---
# Production: postgresql+asyncpg://user:pass@host:5432/yuna
DATABASE_URL=sqlite+aiosqlite:///./yuna.db
AUTO_MIGRATE=true

# --- JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- AI ---
GEMINI_API_KEY=
GEMINI_MOCK=false
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-flash
GEMINI_MODEL_AUDIO=gemini-2.5-flash

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=devsecret

# --- Fayllar ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yuna-files
UPLOAD_MAX_MB=20

# --- Push ---
FCM_CREDENTIALS_JSON=
